# PRODUCTION ENVIRONMENT FILE EXAMPLE
# Copy this to .env and fill in your actual production values
# NEVER commit .env to git!

# ========================================
# DATABASE CONFIGURATION
# ========================================
POSTGRES_USER=medmanager_prod
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_123!
POSTGRES_DB=MedManagerProd

# ========================================
# JWT CONFIGURATION
# ========================================
# Generate a strong random key with: openssl rand -base64 64
JWT_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG!
JWT_ISSUER=MedManagerApi
JWT_AUDIENCE=MedManagerApiClients
JWT_EXPIRY_MINUTES=60

# ========================================
# EMAIL CONFIGURATION - Choose Your Provider
# ========================================
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=MedManager

# Option 1: Brevo (Recommended for Vietnam - 300 emails/day free)
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@example.com
EMAIL_SMTP_PASSWORD=YOUR_BREVO_SMTP_KEY
EMAIL_ENABLE_SSL=true

# Option 2: Gmail (Good for testing - 500 emails/day)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# EMAIL_ENABLE_SSL=true

# Option 3: Mailgun (High volume - 5,000 emails/month)
# EMAIL_SMTP_HOST=smtp.mailgun.org
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=postmaster@your-domain.mailgun.org
# EMAIL_SMTP_PASSWORD=YOUR_MAILGUN_SMTP_PASSWORD
# EMAIL_ENABLE_SSL=true

# ========================================
# SUPERADMIN CONFIGURATION
# ========================================
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=YOUR_SUPER_ADMIN_PASSWORD_123!

# ========================================
# APPLICATION SETTINGS
# ========================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# ========================================
# SECURITY CHECKLIST:
# ========================================
# [ ] Changed all default passwords
# [ ] Generated secure JWT key (64+ characters)
# [ ] Configured email provider (Brevo/Gmail/Mailgun)
# [ ] Updated domain name in nginx/nginx.conf
# [ ] Obtained SSL certificate (certbot)
# [ ] Never committed this file to Git
# [ ] Backed up this file securely
# [ ] Different credentials than development

# ========================================
# QUICK SETUP GUIDE:
# ========================================
# 1. Generate JWT key: openssl rand -base64 64
# 2. Sign up for Brevo: https://www.brevo.com
# 3. Get SMTP credentials from Brevo dashboard
# 4. Update nginx.conf with your domain
# 5. Get SSL cert: sudo certbot certonly --standalone -d yourdomain.com
# 6. Run: ./deploy.sh
