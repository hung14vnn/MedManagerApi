{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MedManager;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "MedManagerApi",
    "Audience": "MedManagerApiClients",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "MedManager",
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "SmtpUser": "YOUR_BREVO_LOGIN_EMAIL",
    "SmtpPassword": "YOUR_BREVO_SMTP_KEY",
    "EnableSsl": true
  }
}
