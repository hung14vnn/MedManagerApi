@MedManagerApi_HostAddress = https://localhost:5001

### Get all drugs (no search)
GET {{MedManagerApi_HostAddress}}/api/drugs

###

### Search drugs by name
GET {{MedManagerApi_HostAddress}}/api/drugs?search=amoxicillin

###

### Create a new drug - Amoxicillin
POST {{MedManagerApi_HostAddress}}/api/drugs
Content-Type: application/json

{
  "activeIngredient": "Amoxicillin",
  "brandName": "Amoxil",
  "pharmacologicalGroup": "Beta-lactam Antibiotics",
  "indications": "Treatment of bacterial infections including respiratory tract, urinary tract, skin infections",
  "contraindications": "Hypersensitivity to penicillins",
  "dosageAdults": "500mg every 8 hours or 875mg every 12 hours",
  "dosageChildren": "25-45 mg/kg/day divided into 2-3 doses",
  "dosageHepaticImpairment": "No adjustment needed",
  "dosageRenalImpairment": "CrCl <30 mL/min: reduce dose or extend interval",
  "adverseEffects": "Diarrhea, nausea, vomiting, skin rash, vaginal candidiasis",
  "pregnancyPrecautions": "Category B - Safe to use during pregnancy",
  "breastfeedingPrecautions": "Compatible with breastfeeding, small amounts excreted in milk",
  "otherPrecautions": "Monitor for allergic reactions. Risk of Clostridium difficile infection"
}

###

### Get drug by ID
GET {{MedManagerApi_HostAddress}}/api/drugs/1

###

### Create drug - Warfarin
POST {{MedManagerApi_HostAddress}}/api/drugs
Content-Type: application/json

{
  "activeIngredient": "Warfarin",
  "brandName": "Coumadin",
  "pharmacologicalGroup": "Anticoagulants - Vitamin K Antagonists",
  "indications": "Prevention and treatment of venous thrombosis, pulmonary embolism, thromboembolic complications of atrial fibrillation",
  "contraindications": "Active bleeding, severe liver disease, pregnancy",
  "dosageAdults": "Initial: 2-5mg daily, adjust based on INR (target INR 2-3 for most indications)",
  "dosageChildren": "Not routinely used in children",
  "dosageHepaticImpairment": "Use with caution, enhanced effect possible",
  "dosageRenalImpairment": "No adjustment needed but monitor closely",
  "adverseEffects": "Bleeding, bruising, hair loss, skin necrosis (rare)",
  "pregnancyPrecautions": "Category X - Contraindicated, teratogenic",
  "breastfeedingPrecautions": "Compatible - minimal excretion in breast milk",
  "otherPrecautions": "Numerous drug interactions. Regular INR monitoring required. Diet affects dosing"
}

###

### Add reference to drug
POST {{MedManagerApi_HostAddress}}/api/drugs/1/references
Content-Type: application/json

{
  "title": "Amoxicillin pharmacokinetics and clinical efficacy",
  "authors": "Smith J, Johnson M",
  "source": "Journal of Antimicrobial Chemotherapy",
  "url": "https://example.com/article",
  "publicationDate": "2023-01-15",
  "doi": "10.1093/jac/dkz999"
}

###

### Create drug interaction
POST {{MedManagerApi_HostAddress}}/api/interactions
Content-Type: application/json

{
  "drug1Id": 1,
  "drug2Id": 2,
  "severity": "Moderate",
  "mechanism": "Amoxicillin may alter gut flora and reduce vitamin K production, potentially enhancing warfarin effect",
  "clinicalEffects": "Increased anticoagulant effect, elevated INR, increased bleeding risk",
  "managementRecommendations": "Monitor INR more frequently during and after antibiotic course. Consider INR check 3-5 days after starting or stopping antibiotic. Educate patient about bleeding signs."
}

###

### Check drug interactions
POST {{MedManagerApi_HostAddress}}/api/interactions/check
Content-Type: application/json

{
  "drugIds": [1, 2]
}

###

### Get interaction by ID
GET {{MedManagerApi_HostAddress}}/api/interactions/1

###

### Add reference to interaction
POST {{MedManagerApi_HostAddress}}/api/interactions/1/references
Content-Type: application/json

{
  "title": "Antibiotic-warfarin interactions: A systematic review",
  "authors": "Brown A, Davis K, Wilson R",
  "source": "Clinical Pharmacology & Therapeutics",
  "url": "https://example.com/antibiotic-warfarin",
  "publicationDate": "2022-06-10",
  "doi": "10.1002/cpt.2567"
}

###

### Create a disease
POST {{MedManagerApi_HostAddress}}/api/diseases
Content-Type: application/json

{
  "name": "Hypertension",
  "icdCode": "I10",
  "description": "Persistent elevation of blood pressure ?140/90 mmHg"
}

###

### Get all diseases
GET {{MedManagerApi_HostAddress}}/api/diseases

###

### Create drug - Lisinopril
POST {{MedManagerApi_HostAddress}}/api/drugs
Content-Type: application/json

{
  "activeIngredient": "Lisinopril",
  "brandName": "Prinivil, Zestril",
  "pharmacologicalGroup": "ACE Inhibitors",
  "indications": "Hypertension, heart failure, post-myocardial infarction",
  "contraindications": "Pregnancy, bilateral renal artery stenosis, history of angioedema",
  "dosageAdults": "Hypertension: 10-40mg once daily. Heart failure: Start 2.5-5mg once daily",
  "dosageChildren": "?6 years: 0.07 mg/kg once daily (max 5mg), titrate up to 0.6 mg/kg or 40mg",
  "dosageHepaticImpairment": "No adjustment needed",
  "dosageRenalImpairment": "CrCl <30: Start with 2.5-5mg daily",
  "adverseEffects": "Dry cough, dizziness, hypotension, hyperkalemia, angioedema (rare)",
  "pregnancyPrecautions": "Category D - Contraindicated, causes fetal harm",
  "breastfeedingPrecautions": "Use caution, limited data available",
  "otherPrecautions": "Monitor BP, renal function, and potassium. First dose hypotension possible"
}

###

### Add treatment protocol
POST {{MedManagerApi_HostAddress}}/api/diseases/protocols
Content-Type: application/json

{
  "diseaseId": 1,
  "drugId": 3,
  "isPreferred": true,
  "preferenceOrder": 1,
  "dosageRecommendation": "Start with 10mg once daily, may increase to 20-40mg based on response",
  "specialConditions": "First-line therapy for most patients. Preferred in patients with diabetes or CKD",
  "notes": "Monitor BP after 2-4 weeks, adjust dose if needed. Target BP <130/80 mmHg"
}

###

### Get treatment protocol for disease
GET {{MedManagerApi_HostAddress}}/api/diseases/1/treatment

###
